<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ACT-11" targetNamespace="https://ver.cy/processes">
<bpmn:process id="ACT-11" name="Rollback and compensation" isExecutable="false">
<bpmn:startEvent id="Start_1" name="Failed verification, harm signal or rollback order"/>
<bpmn:exclusiveGateway id="Gw_1" name="Reversible, compensable or irreversible?"/>
<bpmn:task id="Step_1" name="2. Validate rollback plan against reality (T2)"/>
<bpmn:exclusiveGateway id="Gw_2" name="Is the plan still valid?"/>
<bpmn:endEvent id="End_2" name="Stale plan: new decision via ACT-5"/>
<bpmn:task id="Step_6" name="Draft compensation plan (full-loop actuation)"/>
<bpmn:task id="Step_7" name="Plan mitigation; residual recording mandatory"/>
<bpmn:task id="Step_2" name="3. Issue commands through ACT-6 (Agent T2)"/>
<bpmn:task id="Step_3" name="4. Verify restoration through ACT-9"/>
<bpmn:task id="Step_4" name="5. Record residual impact honestly (MIR-10)"/>
<bpmn:task id="Step_5" name="6. Feed lessons to ACT-1, ACT-3, ACT-4, QSC-14"/>
<bpmn:endEvent id="End_1" name="Restored or compensated; lessons routed"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Gw_1"/>
<bpmn:sequenceFlow id="Flow_2" name="reversible" sourceRef="Gw_1" targetRef="Step_1"/>
<bpmn:sequenceFlow id="Flow_3" name="compensable" sourceRef="Gw_1" targetRef="Step_6"/>
<bpmn:sequenceFlow id="Flow_4" name="irreversible" sourceRef="Gw_1" targetRef="Step_7"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="Step_1" targetRef="Gw_2"/>
<bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gw_2" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gw_2" targetRef="End_2"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="Step_6" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="Step_7" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Step_2" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="Step_3" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="Step_4" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="Step_5" targetRef="End_1"/>
</bpmn:process>
