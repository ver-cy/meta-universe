<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ACT-1" targetNamespace="https://ver.cy/processes">
<bpmn:process id="ACT-1" name="Actionable signal definition and cataloging" isExecutable="false">
<bpmn:startEvent id="Start_1" name="Decision need, incident, genesis or recert due"/>
<bpmn:task id="Step_1" name="1. Capture condition and target decision (Agent T1)"/>
<bpmn:task id="Step_2" name="2. Resolve sources in Mastership Register (Agent T1)"/>
<bpmn:exclusiveGateway id="Gw_1" name="Sources fresh enough to act on?"/>
<bpmn:endEvent id="End_2" name="Not registered until sensing cadence fixed"/>
<bpmn:task id="Step_3" name="3. Draft signal class, route and tier (Agent T1)"/>
<bpmn:exclusiveGateway id="Gw_2" name="Auto-decidable at T3 eligible?"/>
<bpmn:task id="Step_4" name="Require corroboration or T2 or stricter route"/>
<bpmn:exclusiveGateway id="Gw_3" name="Influence outside model or Steward section?"/>
<bpmn:task id="Step_5" name="Obtain Owner approval (GOV-1)"/>
<bpmn:task id="Step_6" name="6. Register class via CON chain (Steward T1)"/>
<bpmn:task id="Step_7" name="7. Bind to emission; recertify on cadence (Agent T3)"/>
<bpmn:endEvent id="End_1" name="Signal class active and bound to ACT-2"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Gw_1"/>
<bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Gw_1" targetRef="End_2"/>
<bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_1" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3" targetRef="Gw_2"/>
<bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gw_2" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gw_2" targetRef="Gw_3"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="Step_4" targetRef="Gw_3"/>
<bpmn:sequenceFlow id="Flow_10" name="yes" sourceRef="Gw_3" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_11" name="no" sourceRef="Gw_3" targetRef="Step_6"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="Step_5" targetRef="Step_6"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="Step_6" targetRef="Step_7"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="Step_7" targetRef="End_1"/>
</bpmn:process>
