<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ACT-8" targetNamespace="https://ver.cy/processes">
<bpmn:process id="ACT-8" name="Reality-first change registration (reality-ahead pattern)" isExecutable="false">
<bpmn:startEvent id="Start_1" name="Pattern E command or declared emergency actuation"/>
<bpmn:exclusiveGateway id="Gw_1" name="Pattern E target or declared emergency met?"/>
<bpmn:endEvent id="End_2" name="Routine Pattern M: routed to ACT-7"/>
<bpmn:task id="Step_1" name="2. Record intent; pin emergency evidence (Agent T3)"/>
<bpmn:task id="Step_2" name="3. Actuate in external system or reality (Agent T3)"/>
<bpmn:exclusiveGateway id="Gw_2" name="Pattern E target with a mirror?"/>
<bpmn:task id="Step_6" name="Regularize via retroactive ACT-7 (Pattern M)"/>
<bpmn:endEvent id="End_3" name="Pattern M emergency regularized via ACT-7"/>
<bpmn:task id="Step_3" name="4. Force out-of-cycle re-harvest (MIR-2) (Agent T3)"/>
<bpmn:task id="Step_4" name="5. Land raw capture; transform into mirror (T3)"/>
<bpmn:task id="Step_5" name="6. Cause-link mirror to command; stamp MIR-10 (T3)"/>
<bpmn:exclusiveGateway id="Gw_3" name="Emergency invocation needing regularization?"/>
<bpmn:endEvent id="End_1" name="Closed: mirror confirms; verified via ACT-9"/>
<bpmn:task id="Step_7" name="7. Retroactive assessment and decision (Agent T2)"/>
<bpmn:exclusiveGateway id="Gw_4" name="Regularized within backfill window?"/>
<bpmn:endEvent id="End_4" name="Emergency actuation regularized and closed"/>
<bpmn:endEvent id="End_5" name="Escalated to Owner and Auditor; QSC-14 opened"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Gw_1"/>
<bpmn:sequenceFlow id="Flow_2" name="no: routine Pattern M" sourceRef="Gw_1" targetRef="End_2"/>
<bpmn:sequenceFlow id="Flow_3" name="yes" sourceRef="Gw_1" targetRef="Step_1"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="Step_1" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="Step_2" targetRef="Gw_2"/>
<bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gw_2" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_7" name="no: Pattern M emergency" sourceRef="Gw_2" targetRef="Step_6"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="Step_6" targetRef="End_3"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="Step_3" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Step_4" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="Step_5" targetRef="Gw_3"/>
<bpmn:sequenceFlow id="Flow_12" name="no" sourceRef="Gw_3" targetRef="End_1"/>
<bpmn:sequenceFlow id="Flow_13" name="yes" sourceRef="Gw_3" targetRef="Step_7"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="Step_7" targetRef="Gw_4"/>
<bpmn:sequenceFlow id="Flow_15" name="yes" sourceRef="Gw_4" targetRef="End_4"/>
<bpmn:sequenceFlow id="Flow_16" name="no" sourceRef="Gw_4" targetRef="End_5"/>
</bpmn:process>
