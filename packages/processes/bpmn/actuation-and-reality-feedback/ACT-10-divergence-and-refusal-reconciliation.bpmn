<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ACT-10" targetNamespace="https://ver.cy/processes">
<bpmn:process id="ACT-10" name="Divergence and refusal reconciliation" isExecutable="false">
<bpmn:startEvent id="Start_1" name="Failed verification, refusal, drift or divergence"/>
<bpmn:task id="Step_1" name="1. Characterize the divergence (Agent T2)"/>
<bpmn:exclusiveGateway id="Gw_1" name="Which side is authoritative per conflict rule?"/>
<bpmn:task id="Step_2" name="3. Re-harvest model; supersede failed intent (T2)"/>
<bpmn:task id="Step_3" name="4. Corrective actuation via ACT-6 or ACT-5 (T2)"/>
<bpmn:exclusiveGateway id="Gw_2" name="Wrong mastership, signal class or contract?"/>
<bpmn:task id="Step_4" name="5. Propose changes to MIR-1, ACT-1 or ACT-3 (T1)"/>
<bpmn:task id="Step_5" name="6. Record reconciliation; notify via CON-13"/>
<bpmn:exclusiveGateway id="Gw_3" name="Repeated divergence past declared threshold?"/>
<bpmn:endEvent id="End_1" name="Model and reality reconciled"/>
<bpmn:endEvent id="End_2" name="Auditor review opened instead of retry"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Gw_1"/>
<bpmn:sequenceFlow id="Flow_3" name="external wins" sourceRef="Gw_1" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_4" name="model wins" sourceRef="Gw_1" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="Step_2" targetRef="Gw_2"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3" targetRef="Gw_2"/>
<bpmn:sequenceFlow id="Flow_7" name="yes" sourceRef="Gw_2" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_8" name="no" sourceRef="Gw_2" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="Step_4" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Step_5" targetRef="Gw_3"/>
<bpmn:sequenceFlow id="Flow_11" name="no" sourceRef="Gw_3" targetRef="End_1"/>
<bpmn:sequenceFlow id="Flow_12" name="yes" sourceRef="Gw_3" targetRef="End_2"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_ACT-10">
