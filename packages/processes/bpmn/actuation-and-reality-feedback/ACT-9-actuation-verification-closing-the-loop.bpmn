<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ACT-9" targetNamespace="https://ver.cy/processes">
<bpmn:process id="ACT-9" name="Actuation verification (closing the loop)" isExecutable="false">
<bpmn:startEvent id="Start_1" name="Command at effect time, harvest done or sample drawn"/>
<bpmn:task id="Step_1" name="1. Gather evidence per sealed criteria (Agent T3)"/>
<bpmn:exclusiveGateway id="Gw_1" name="Independent evidence required and missing?"/>
<bpmn:task id="Step_6" name="2. Request independent sensing (MIR-2, disjoint)"/>
<bpmn:task id="Step_2" name="3. Compare intended vs sensed state (Agent T3)"/>
<bpmn:task id="Step_3" name="5. Record verification; stamp MIR-10 reason (T3)"/>
<bpmn:exclusiveGateway id="Gw_2" name="Conformed, partial, failed or unverifiable?"/>
<bpmn:task id="Step_4" name="6. Trigger ACT-7 promotion or close ACT-8 record"/>
<bpmn:endEvent id="End_2" name="Partial or failed: routed to ACT-10"/>
<bpmn:task id="Step_5" name="8. Escalate to Steward as unconfirmed (Agent T2)"/>
<bpmn:endEvent id="End_1" name="Loop closed by evidence"/>
<bpmn:endEvent id="End_3" name="Unconfirmed actuation escalated to Steward"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Gw_1"/>
<bpmn:sequenceFlow id="Flow_3" name="yes" sourceRef="Gw_1" targetRef="Step_6"/>
<bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Gw_1" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="Step_6" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="Step_2" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="Step_3" targetRef="Gw_2"/>
<bpmn:sequenceFlow id="Flow_8" name="conformed" sourceRef="Gw_2" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_9" name="partial or failed" sourceRef="Gw_2" targetRef="End_2"/>
<bpmn:sequenceFlow id="Flow_10" name="unverifiable" sourceRef="Gw_2" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="Step_4" targetRef="End_1"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="Step_5" targetRef="End_3"/>
</bpmn:process>
