<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ACT-5" targetNamespace="https://ver.cy/processes">
<bpmn:process id="ACT-5" name="Actuation decision" isExecutable="false">
<bpmn:startEvent id="Start_1" name="Signal, owner directive, emergency or rollback input"/>
<bpmn:exclusiveGateway id="Gw_1" name="Cataloged signal, owner directive or emergency?"/>
<bpmn:endEvent id="End_2" name="Routed to ACT-1; no silent decision"/>
<bpmn:task id="Step_1" name="2. Verify authority against tier map (Agent T3)"/>
<bpmn:exclusiveGateway id="Gw_2" name="Does the decider hold authority?"/>
<bpmn:endEvent id="End_3" name="Escalated via GOV-1 ladder"/>
<bpmn:task id="Step_2" name="3. Review impact assessment (Agent T3)"/>
<bpmn:exclusiveGateway id="Gw_3" name="Actuate, reject or defer?"/>
<bpmn:endEvent id="End_4" name="Reject or defer recorded with rationale"/>
<bpmn:task id="Step_3" name="5. Fix action, effector, criteria, rollback, expiry"/>
<bpmn:task id="Step_4" name="6. Sign and record decision event (CON-1 channel)"/>
<bpmn:task id="Step_5" name="7. Route to ACT-6; register picks ACT-7 or ACT-8"/>
<bpmn:endEvent id="End_1" name="Decision routed to command issue (ACT-6)"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Gw_1"/>
<bpmn:sequenceFlow id="Flow_2" name="yes" sourceRef="Gw_1" targetRef="Step_1"/>
<bpmn:sequenceFlow id="Flow_3" name="no" sourceRef="Gw_1" targetRef="End_2"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="Step_1" targetRef="Gw_2"/>
<bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_2" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_2" targetRef="End_3"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="Step_2" targetRef="Gw_3"/>
<bpmn:sequenceFlow id="Flow_8" name="actuate" sourceRef="Gw_3" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_9" name="reject or defer" sourceRef="Gw_3" targetRef="End_4"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Step_3" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="Step_4" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="Step_5" targetRef="End_1"/>
</bpmn:process>
