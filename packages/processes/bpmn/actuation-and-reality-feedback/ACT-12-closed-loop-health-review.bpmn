<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ACT-12" targetNamespace="https://ver.cy/processes">
<bpmn:process id="ACT-12" name="Closed-loop health review" isExecutable="false">
<bpmn:startEvent id="Start_1" name="Cadence, metric breach, incident review or request"/>
<bpmn:task id="Step_1" name="1. Sample end-to-end loop traces (Agent T3)"/>
<bpmn:exclusiveGateway id="Gw_1" name="Any orphan links in the chains?"/>
<bpmn:task id="Step_8" name="File orphan findings into QSC-11 (Auditor)"/>
<bpmn:task id="Step_2" name="2. Measure loop latency per stage (Agent T3)"/>
<bpmn:task id="Step_3" name="3. Review Agent error rates per tier (Auditor)"/>
<bpmn:exclusiveGateway id="Gw_2" name="Tier promotion or demotion warranted?"/>
<bpmn:task id="Step_9" name="Route tier proposals into CTX-9 step 8"/>
<bpmn:task id="Step_4" name="4. Review emergency usage and budgets (Agent T3)"/>
<bpmn:task id="Step_5" name="5. Compare predicted vs observed impact (Agent T3)"/>
<bpmn:task id="Step_6" name="6. Draft report; raise versioned proposals (T2)"/>
<bpmn:task id="Step_7" name="7. Attest loop health to Owner (GOV-1) (Auditor)"/>
<bpmn:endEvent id="End_1" name="Loop health attested; proposals filed"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Gw_1"/>
<bpmn:sequenceFlow id="Flow_3" name="yes" sourceRef="Gw_1" targetRef="Step_8"/>
<bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Gw_1" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="Step_8" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="Step_2" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="Step_3" targetRef="Gw_2"/>
<bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gw_2" targetRef="Step_9"/>
<bpmn:sequenceFlow id="Flow_9" name="no" sourceRef="Gw_2" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Step_9" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="Step_4" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="Step_5" targetRef="Step_6"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="Step_6" targetRef="Step_7"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="Step_7" targetRef="End_1"/>
</bpmn:process>
