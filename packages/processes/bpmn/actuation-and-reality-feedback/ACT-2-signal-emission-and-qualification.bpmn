<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ACT-2" targetNamespace="https://ver.cy/processes">
<bpmn:process id="ACT-2" name="Signal emission and qualification" isExecutable="false">
<bpmn:startEvent id="Start_1" name="Scheduled evaluation, source change or manual raise"/>
<bpmn:task id="Step_1" name="1. Evaluate cataloged conditions (Agent T3)"/>
<bpmn:exclusiveGateway id="Gw_1" name="Condition met?"/>
<bpmn:endEvent id="End_2" name="No signal; evaluation logged"/>
<bpmn:task id="Step_2" name="3. Check freshness, trust and quarantine (Agent T3)"/>
<bpmn:exclusiveGateway id="Gw_2" name="Fresh, trusted and quarantine clear?"/>
<bpmn:task id="Step_7" name="Re-harvest, degrade or block per class rule (Agent T2)"/>
<bpmn:task id="Step_3" name="4. Compose signal event citing evidence (Agent T3)"/>
<bpmn:task id="Step_4" name="5. Deduplicate and correlate open signals (Agent T3)"/>
<bpmn:exclusiveGateway id="Gw_3" name="New, duplicate or continuation?"/>
<bpmn:endEvent id="End_3" name="Suppressed or merged; logged append-only"/>
<bpmn:task id="Step_5" name="6. Qualify confidence and impact class (Agent T2)"/>
<bpmn:task id="Step_6" name="7. Record emission; route to ACT-5 (Agent T3)"/>
<bpmn:endEvent id="End_1" name="Qualified signal routed to ACT-5"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Gw_1"/>
<bpmn:sequenceFlow id="Flow_3" name="no" sourceRef="Gw_1" targetRef="End_2"/>
<bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gw_1" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="Step_2" targetRef="Gw_2"/>
<bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_2" targetRef="Step_7"/>
<bpmn:sequenceFlow id="Flow_7" name="yes" sourceRef="Gw_2" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="Step_7" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="Step_3" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Step_4" targetRef="Gw_3"/>
<bpmn:sequenceFlow id="Flow_11" name="new" sourceRef="Gw_3" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_12" name="duplicate or continuation" sourceRef="Gw_3" targetRef="End_3"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="Step_5" targetRef="Step_6"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="Step_6" targetRef="End_1"/>
</bpmn:process>
