<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ACT-7" targetNamespace="https://ver.cy/processes">
<bpmn:process id="ACT-7" name="Model-first change (intent-ahead pattern)" isExecutable="false">
<bpmn:startEvent id="Start_1" name="Pattern M command, planned change or ACT-8 handover"/>
<bpmn:exclusiveGateway id="Gw_1" name="Is the target dataset model-mastered?"/>
<bpmn:endEvent id="End_2" name="Wrong pattern: routed to ACT-8"/>
<bpmn:task id="Step_1" name="2. Author intended state as pending version (T1)"/>
<bpmn:task id="Step_2" name="3. Record actuation-intent event (CON chain) (T3)"/>
<bpmn:task id="Step_3" name="4. Publish projection or command effector (Agent T2)"/>
<bpmn:task id="Step_4" name="5. Await verification evidence via ACT-9 (Agent T3)"/>
<bpmn:exclusiveGateway id="Gw_2" name="Did reality conform?"/>
<bpmn:endEvent id="End_3" name="Kept in Proposed; routed to ACT-10"/>
<bpmn:task id="Step_5" name="6. Promote version to Active on evidence (T3)"/>
<bpmn:task id="Step_6" name="7. Close with cause-linked events (Agent T3)"/>
<bpmn:endEvent id="End_1" name="Intent promoted to Active on verified evidence"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Gw_1"/>
<bpmn:sequenceFlow id="Flow_2" name="no" sourceRef="Gw_1" targetRef="End_2"/>
<bpmn:sequenceFlow id="Flow_3" name="yes" sourceRef="Gw_1" targetRef="Step_1"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="Step_1" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="Step_2" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="Step_4" targetRef="Gw_2"/>
<bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gw_2" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_9" name="no or partial" sourceRef="Gw_2" targetRef="End_3"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Step_5" targetRef="Step_6"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="Step_6" targetRef="End_1"/>
</bpmn:process>
