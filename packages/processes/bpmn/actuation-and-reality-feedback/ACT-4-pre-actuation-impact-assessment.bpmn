<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ACT-4" targetNamespace="https://ver.cy/processes">
<bpmn:process id="ACT-4" name="Pre-actuation impact assessment" isExecutable="false">
<bpmn:startEvent id="Start_1" name="Signal requiring assessment or above-floor action"/>
<bpmn:task id="Step_1" name="1. Resolve target meta-objects (Agent T2)"/>
<bpmn:task id="Step_2" name="2. Traverse graph to bound affected set (Agent T2)"/>
<bpmn:task id="Step_3" name="3. Classify reversibility from contract (Agent T2)"/>
<bpmn:exclusiveGateway id="Gw_1" name="Affected set crosses ownership boundaries?"/>
<bpmn:task id="Step_7" name="Obtain affected Owner grant before decision (T1)"/>
<bpmn:task id="Step_4" name="5. Estimate value, cost and risk; simulate (T2)"/>
<bpmn:task id="Step_5" name="6. Derive decision tier; irreversible is T1"/>
<bpmn:task id="Step_6" name="7. Record assessment citing model versions (T2)"/>
<bpmn:endEvent id="End_1" name="Assessment recorded and attached to signal"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Gw_1"/>
<bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_1" targetRef="Step_7"/>
<bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_1" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="Step_7" targetRef="Step_4"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="Step_4" targetRef="Step_5"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="Step_5" targetRef="Step_6"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Step_6" targetRef="End_1"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_ACT-4">
<bpmndi:BPMNPlane id="Plane_ACT-4" bpmnElement="ACT-4">
<bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="192" width="36" height="36"/></bpmndi:BPMNShape>
