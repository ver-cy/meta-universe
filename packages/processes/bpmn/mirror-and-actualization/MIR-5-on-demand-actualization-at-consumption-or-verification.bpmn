<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_MIR-5" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="MIR-5" name="On-demand actualization at consumption or verification" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Request depends on mirrored dataset">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Step_1" name="1. Resolve dependent datasets in register (Agent T3)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_1" name="Dataset model-mastered?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_2" name="Answered from model record (cited)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Step_2" name="3. Compare harvest age against staleness limit (Agent T3)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_2" name="Within limit and not quarantined?">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_3" name="Answered from fresh mirror (cited)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_3" name="Stale but re-harvestable now?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Step_3" name="5. Run targeted MIR-2 re-harvest (Agent T3)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_4" name="Answered from re-harvested fresh state">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_4" name="Stale and not re-harvestable: policy?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Step_5" name="6. Answer with explicit staleness disclosure (Agent T3)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_6" name="6. Refuse; request grant via GOV-7 (T1)">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_1" name="Answered with staleness disclosure">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_5" name="Refused: stale, grant requested via GOV-7">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Gw_1" targetRef="End_2" name="yes" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gw_1" targetRef="Step_2" name="no" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_2" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gw_2" targetRef="End_3" name="yes" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_2" targetRef="Gw_3" name="no" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Gw_3" targetRef="Step_3" name="yes" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_3" targetRef="End_4" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gw_3" targetRef="Gw_4" name="no" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_4" targetRef="Step_5" name="disclose" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_5" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gw_4" targetRef="Step_6" name="refuse" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Step_6" targetRef="End_5" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_MIR-5">
    <bpmndi:BPMNPlane id="Plane_MIR-5" bpmnElement="MIR-5">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_1" bpmnElement="Step_1">
        <dc:Bounds x="370" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_1" bpmnElement="Gw_1">
        <dc:Bounds x="580" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_2" bpmnElement="End_2">
        <dc:Bounds x="685" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_2" bpmnElement="Step_2">
        <dc:Bounds x="790" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_2" bpmnElement="Gw_2">
        <dc:Bounds x="1000" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_3" bpmnElement="End_3">
        <dc:Bounds x="1105" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_3" bpmnElement="Gw_3">
        <dc:Bounds x="1210" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_3" bpmnElement="Step_3">
        <dc:Bounds x="1315" y="330" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_4" bpmnElement="End_4">
        <dc:Bounds x="1505" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_4" bpmnElement="Gw_4">
        <dc:Bounds x="1420" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_5" bpmnElement="Step_5">
        <dc:Bounds x="1630" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_6" bpmnElement="Step_6">
        <dc:Bounds x="1525" y="330" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="1840" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_5" bpmnElement="End_5">
        <dc:Bounds x="1715" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="210" />
        <di:waypoint x="370" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="530" y="210" />
        <di:waypoint x="580" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="630" y="210" />
        <di:waypoint x="685" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="630" y="210" />
        <di:waypoint x="790" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="950" y="210" />
        <di:waypoint x="1000" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="1050" y="210" />
        <di:waypoint x="1105" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="1050" y="210" />
        <di:waypoint x="1210" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1260" y="210" />
        <di:waypoint x="1315" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="1475" y="370" />
        <di:waypoint x="1505" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1260" y="210" />
        <di:waypoint x="1420" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1470" y="210" />
        <di:waypoint x="1630" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1790" y="210" />
        <di:waypoint x="1840" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="1470" y="210" />
        <di:waypoint x="1525" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="1685" y="370" />
        <di:waypoint x="1715" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
