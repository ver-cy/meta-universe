<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_QSC-9" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="QSC-9" name="Integrity verification" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Scheduled run, backup event, or publication">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Step_1" name="1. Recompute, compare fingerprint (Agent T3)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_2" name="2. Verify raw captures against attestations (Agent T3)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_3" name="3. Verify append-only, hash-chained logs (Agent T3)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_4" name="4. Verify signatures against GOV-8 keys (Agent T3)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_5" name="5. Verify MIR-7 ran, sample honesty (Agent T3)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_1" name="Mismatch vs MIR-7 records?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Step_5b" name="5a. Raise finding to MIR-7 (Agent T3)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_6" name="6. Anchor security-critical dataset hashes (Agent T3)">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_2" name="Unexplained diff found?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Step_6b" name="6a. Open QSC-8 immediately (Steward T1)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_1" name="QSC-8 opened on integrity diff">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Step_7" name="7. Test-restore backup sample (Agent T3)">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_3" name="Other unexplained mismatch?">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Step_7b" name="8a. Place integrity hold, open QSC-14 (Steward T2)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_8" name="9. Publish integrity report (Agent T3)">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_2" name="Integrity report published">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_5" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_1" targetRef="Step_5b" name="yes" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5b" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gw_1" targetRef="Step_6" name="no" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_6" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_2" targetRef="Step_6b" name="yes" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_6b" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gw_2" targetRef="Step_7" name="no" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Step_7" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gw_3" targetRef="Step_7b" name="yes" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Step_7b" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gw_3" targetRef="Step_8" name="no" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Step_8" targetRef="End_2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_QSC-9">
    <bpmndi:BPMNPlane id="Plane_QSC-9" bpmnElement="QSC-9">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
