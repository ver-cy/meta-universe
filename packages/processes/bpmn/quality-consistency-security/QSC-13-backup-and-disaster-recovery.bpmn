<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_QSC-13" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="QSC-13" name="Backup and disaster recovery" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Standing cadence, drill schedule, or loss event">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Step_1" name="1. Execute backup jobs, write manifests (Agent T3)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_2" name="2. Replicate offsite with custody separation (Agent T3)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_3" name="3. Verify manifest completeness and hashes (Agent T3)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_1" name="Criticality class outside RPO?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Step_3b" name="4a. Open QSC-14 incident (Steward)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_4" name="5. Run full-DR drill, measure RTO/RPO (Agent T2)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_2" name="Drill missed target or gap found?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Step_4b" name="6a. File findings to QSC-11 and QSC-14 (Steward)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_5" name="7. Restore per runbook under QSC-14 command (Owner T1)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_6" name="8. Record Events, route lessons via QSC-14 (Steward)">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_1" name="Backup and DR cycle recorded">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gw_1" targetRef="Step_3b" name="yes" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3b" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_1" targetRef="Step_4" name="no" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_4" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gw_2" targetRef="Step_4b" name="yes" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_4b" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_2" targetRef="Step_5" name="no" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Step_6" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_QSC-13">
    <bpmndi:BPMNPlane id="Plane_QSC-13" bpmnElement="QSC-13">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_1" bpmnElement="Step_1">
        <dc:Bounds x="370" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_2" bpmnElement="Step_2">
        <dc:Bounds x="580" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_3" bpmnElement="Step_3">
        <dc:Bounds x="790" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_1" bpmnElement="Gw_1">
        <dc:Bounds x="1000" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_3b" bpmnElement="Step_3b">
        <dc:Bounds x="1105" y="330" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_4" bpmnElement="Step_4">
        <dc:Bounds x="1210" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_2" bpmnElement="Gw_2">
        <dc:Bounds x="1420" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_4b" bpmnElement="Step_4b">
        <dc:Bounds x="1525" y="330" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_5" bpmnElement="Step_5">
        <dc:Bounds x="1630" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_6" bpmnElement="Step_6">
        <dc:Bounds x="1840" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="2050" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="210" />
        <di:waypoint x="370" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="530" y="210" />
        <di:waypoint x="580" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="740" y="210" />
        <di:waypoint x="790" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="950" y="210" />
        <di:waypoint x="1000" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="1050" y="210" />
        <di:waypoint x="1105" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="1265" y="370" />
        <di:waypoint x="1210" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="1050" y="210" />
        <di:waypoint x="1210" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1370" y="210" />
        <di:waypoint x="1420" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="1470" y="210" />
        <di:waypoint x="1525" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1685" y="370" />
        <di:waypoint x="1630" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1470" y="210" />
        <di:waypoint x="1630" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1790" y="210" />
        <di:waypoint x="1840" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="2000" y="210" />
        <di:waypoint x="2050" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
