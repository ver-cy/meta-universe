<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_QSC-14" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="QSC-14" name="Operational incident management and postmortem" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Monitoring escalation, alarm, or reported incident">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Step_1" name="1. Open incident, pin evidence first (Steward)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_2" name="2. Classify severity against rubric (Steward)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_1" name="Security class incident?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Step_2b" name="2a. Hand over to QSC-8 (Steward)">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_1" name="Handed to QSC-8 as security class">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Step_3" name="3. Contain with least destructive step (Agent T2)">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_4" name="4. Eradicate root cause (Agent T2)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_2" name="Severity at or above postmortem floor?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Step_4b" name="5a. Run blameless postmortem (Auditor)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_5" name="6. Route lessons as versioned changes (Steward)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_6" name="7. Close incident with Owner sign-off (Owner T1)">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Step_7" name="8. Track repeat causes across incidents (Steward)">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_2" name="Incident closed">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gw_1" targetRef="Step_2b" name="yes" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_2b" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gw_1" targetRef="Step_3" name="no" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_4" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Gw_2" targetRef="Step_4b" name="yes" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_4b" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_2" targetRef="Step_5" name="no" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Step_6" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Step_7" targetRef="End_2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_QSC-14">
    <bpmndi:BPMNPlane id="Plane_QSC-14" bpmnElement="QSC-14">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_1" bpmnElement="Step_1">
        <dc:Bounds x="370" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_2" bpmnElement="Step_2">
        <dc:Bounds x="580" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_1" bpmnElement="Gw_1">
        <dc:Bounds x="790" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_2b" bpmnElement="Step_2b">
        <dc:Bounds x="895" y="330" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1">
        <dc:Bounds x="1085" y="352" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_3" bpmnElement="Step_3">
        <dc:Bounds x="1000" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_4" bpmnElement="Step_4">
        <dc:Bounds x="1210" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_2" bpmnElement="Gw_2">
        <dc:Bounds x="1420" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_4b" bpmnElement="Step_4b">
        <dc:Bounds x="1525" y="330" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_5" bpmnElement="Step_5">
        <dc:Bounds x="1630" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_6" bpmnElement="Step_6">
        <dc:Bounds x="1840" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_7" bpmnElement="Step_7">
        <dc:Bounds x="2050" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_2" bpmnElement="End_2">
        <dc:Bounds x="2260" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="196" y="210" />
        <di:waypoint x="370" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="530" y="210" />
        <di:waypoint x="580" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="740" y="210" />
        <di:waypoint x="790" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="840" y="210" />
        <di:waypoint x="895" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="1055" y="370" />
        <di:waypoint x="1085" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="840" y="210" />
        <di:waypoint x="1000" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="1160" y="210" />
        <di:waypoint x="1210" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1370" y="210" />
        <di:waypoint x="1420" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="1470" y="210" />
        <di:waypoint x="1525" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1685" y="370" />
        <di:waypoint x="1630" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1470" y="210" />
        <di:waypoint x="1630" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1790" y="210" />
        <di:waypoint x="1840" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="2000" y="210" />
        <di:waypoint x="2050" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="2210" y="210" />
        <di:waypoint x="2260" y="210" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
