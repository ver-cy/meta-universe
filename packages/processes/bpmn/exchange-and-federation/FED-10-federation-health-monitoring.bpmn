<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_FED-10" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="FED-10" name="Federation health monitoring" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Scheduled evaluation, threshold alert, or pre-review" />
    <bpmn:task id="Step_1" name="1. Collect per-federation health signals (Agent T3)" />
    <bpmn:task id="Step_2" name="2. Evaluate against service levels and floors" />
    <bpmn:exclusiveGateway id="Gw_1" name="Any hard floor breached?" />
    <bpmn:task id="Step_3" name="3. Raise incident; mark At-risk; propose suspension" />
    <bpmn:exclusiveGateway id="Gw_2" name="Soft degradation present?" />
    <bpmn:task id="Step_4" name="4. Mark Degraded; open remediation tasks" />
    <bpmn:task id="Step_5" name="5. Compile periodic health report with trends" />
    <bpmn:task id="Step_6" name="6. Steward review: confirm or adjust states (T2)" />
    <bpmn:task id="Step_7" name="7. Owner review: renew, evolve, suspend, terminate" />
    <bpmn:task id="Step_8" name="8. Record every state change as Event" />
    <bpmn:endEvent id="End_1" name="Health cycle recorded" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gw_1" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_5" name="no" sourceRef="Gw_1" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_7" name="yes" sourceRef="Gw_2" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_8" name="no" sourceRef="Gw_2" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Step_6" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_7" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Step_8" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_FED_10">
    <bpmndi:BPMNPlane id="Plane_FED-10" bpmnElement="FED-10">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_1" bpmnElement="Step_1">
        <dc:Bounds x="370" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_2" bpmnElement="Step_2">
        <dc:Bounds x="580" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_1" bpmnElement="Gw_1">
