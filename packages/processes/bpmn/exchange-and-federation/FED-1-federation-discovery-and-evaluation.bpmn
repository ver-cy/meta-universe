<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_FED-1" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="FED-1" name="Federation discovery and evaluation" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Capability need, inquiry, or scheduled scan" />
    <bpmn:task id="Step_1" name="1. Register discovery intent Event" />
    <bpmn:task id="Step_2" name="2. Collect public metadata, schema only (Agent T3)" />
    <bpmn:task id="Step_3" name="3. Verify identity claims and conformance" />
    <bpmn:exclusiveGateway id="Gw_1" name="Usable federation metadata published?" />
    <bpmn:task id="Step_4" name="5. Compile candidate dossier (Agent T3)" />
    <bpmn:task id="Step_5" name="6. Assess initial Trust Vector per dimension (Agent T2)" />
    <bpmn:exclusiveGateway id="Gw_2" name="Engagement predicate satisfied?" />
    <bpmn:task id="Step_6" name="8. Present dossier and recommendation to Owner" />
    <bpmn:exclusiveGateway id="Gw_3" name="Owner approves pursuit? (T1)" />
    <bpmn:task id="Step_7" name="9. Open negotiation case, hand off to FED-2" />
    <bpmn:task id="Step_8" name="10. Record evaluation outcome Event (GOV-1)" />
    <bpmn:endEvent id="End_1" name="Handed off to FED-2" />
    <bpmn:endEvent id="End_2" name="Not-federatable finding recorded" />
    <bpmn:endEvent id="End_3" name="Dossier archived with rationale" />
    <bpmn:endEvent id="End_4" name="Pursuit declined, archived" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_1" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_1" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_9" name="yes" sourceRef="Gw_2" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_10" name="no" sourceRef="Gw_2" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Step_6" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_12" name="yes" sourceRef="Gw_3" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_13" name="no" sourceRef="Gw_3" targetRef="End_4" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Step_7" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Step_8" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_FED_1">
    <bpmndi:BPMNPlane id="Plane_FED-1" bpmnElement="FED-1">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_1" bpmnElement="Step_1">
        <dc:Bounds x="370" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_2" bpmnElement="Step_2">
        <dc:Bounds x="580" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_3" bpmnElement="Step_3">
        <dc:Bounds x="790" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_1" bpmnElement="Gw_1">
        <dc:Bounds x="1000" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_4" bpmnElement="Step_4">
