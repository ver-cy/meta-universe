<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_FED-4" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="FED-4" name="Disclosure review and projection release" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Read request, sync batch, or export request" />
    <bpmn:task id="Step_1" name="1. Resolve to live consent record (fail closed)" />
    <bpmn:task id="Step_2" name="2. Assemble content from declared profile scope" />
    <bpmn:task id="Step_3" name="3. Verify mastership and freshness metadata" />
    <bpmn:task id="Step_4" name="4. Apply shaping per profile (Agent T2/T3)" />
    <bpmn:task id="Step_5" name="5. Run release checklist and composition check" />
    <bpmn:exclusiveGateway id="Gw_1" name="All release checks pass?" />
    <bpmn:exclusiveGateway id="Gw_2" name="First profile use or restricted class?" />
    <bpmn:task id="Step_6" name="Approve concrete release artifact (T1)" />
    <bpmn:task id="Step_7" name="8. Release Projection; log Event in same commit" />
    <bpmn:task id="Step_8" name="9. Post-release audit sample and drift check" />
    <bpmn:endEvent id="End_1" name="Projection released and logged" />
    <bpmn:endEvent id="End_2" name="Blocked: Steward fix or deny (T1)" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_5" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_7" name="yes" sourceRef="Gw_1" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_8" name="no" sourceRef="Gw_1" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_9" name="yes" sourceRef="Gw_2" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_10" name="no" sourceRef="Gw_2" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Step_6" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_7" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Step_8" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_FED_4">
    <bpmndi:BPMNPlane id="Plane_FED-4" bpmnElement="FED-4">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_1" bpmnElement="Step_1">
        <dc:Bounds x="370" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_2" bpmnElement="Step_2">
        <dc:Bounds x="580" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_3" bpmnElement="Step_3">
