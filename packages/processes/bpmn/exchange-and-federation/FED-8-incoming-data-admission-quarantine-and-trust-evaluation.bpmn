<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_FED-8" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="FED-8" name="Incoming-data admission quarantine and trust evaluation" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Inbound payload or scheduled trust re-evaluation" />
    <bpmn:task id="Step_1" name="1. Land payload unmodified with provenance sidecar" />
    <bpmn:task id="Step_2" name="2. Verify envelope: sender, contract, scope" />
    <bpmn:exclusiveGateway id="Gw_1" name="Envelope valid?" />
    <bpmn:task id="Step_3" name="3. Validate content: schema, mappings, references" />
    <bpmn:task id="Step_4" name="4. Screen hazards; instructions stay data (COMMON)" />
    <bpmn:task id="Step_5" name="5. Evaluate against per-dimension Trust Vector (T3)" />
    <bpmn:exclusiveGateway id="Gw_2" name="Promotion floor predicate satisfied?" />
    <bpmn:task id="Step_6" name="6. Promote to mirrors; MIR-2 landing (Agent T3)" />
    <bpmn:task id="Step_7" name="Hold for Steward review (T2)" />
    <bpmn:task id="Step_8" name="7. Update Trust Vector; alert FED-10 on drop" />
    <bpmn:exclusiveGateway id="Gw_3" name="Below contract operating floor predicate?" />
    <bpmn:task id="Step_9" name="8. Notify Steward; possible FED-11 review" />
    <bpmn:task id="Step_10" name="9. Write admission quarantine report Event" />
    <bpmn:endEvent id="End_1" name="Batch processed and reported" />
    <bpmn:endEvent id="End_2" name="Payload rejected, sender notified" />
    <bpmn:endEvent id="End_3" name="Rejected: reasons returned, logged" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gw_1" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_5" name="no" sourceRef="Gw_1" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_9" name="yes" sourceRef="Gw_2" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_10" name="borderline" sourceRef="Gw_2" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_11" name="no" sourceRef="Gw_2" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_7" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Step_6" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Step_8" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_15" name="yes" sourceRef="Gw_3" targetRef="Step_9" />
    <bpmn:sequenceFlow id="Flow_16" name="no" sourceRef="Gw_3" targetRef="Step_10" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Step_9" targetRef="Step_10" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Step_10" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_FED_8">
    <bpmndi:BPMNPlane id="Plane_FED-8" bpmnElement="FED-8">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
