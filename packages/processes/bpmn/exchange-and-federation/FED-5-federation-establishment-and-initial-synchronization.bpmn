<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_FED-5" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="FED-5" name="Federation establishment and initial synchronization" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Signed Federation Contract from FED-2" />
    <bpmn:task id="Step_1" name="1. Verify identity; exchange endpoints, keys (GOV-8)" />
    <bpmn:task id="Step_2" name="2. Establish identity bindings (Agent T2)" />
    <bpmn:task id="Step_3" name="3. Load and validate initial mappings (FED-7)" />
    <bpmn:task id="Step_4" name="4. Dry run one Projection each direction" />
    <bpmn:exclusiveGateway id="Gw_1" name="Dry run clean?" />
    <bpmn:task id="Step_5" name="Fix issues; three failures escalate to Stewards" />
    <bpmn:task id="Step_6" name="6. Initial full exchange via FED-8 and FED-4" />
    <bpmn:task id="Step_7" name="7. Reconcile counts, checksums, spot checks" />
    <bpmn:task id="Step_8" name="8. Record freshness; propose entries to MIR-1" />
    <bpmn:exclusiveGateway id="Gw_2" name="Reconciled and promotions complete?" />
    <bpmn:task id="Step_9" name="10. Declare Active; snapshot baseline (FED-10)" />
    <bpmn:endEvent id="End_1" name="Federation Active" />
    <bpmn:endEvent id="End_2" name="Activation held and escalated" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_4" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gw_1" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gw_1" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_6" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_7" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Step_8" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_12" name="yes" sourceRef="Gw_2" targetRef="Step_9" />
    <bpmn:sequenceFlow id="Flow_13" name="no" sourceRef="Gw_2" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Step_9" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_FED_5">
    <bpmndi:BPMNPlane id="Plane_FED-5" bpmnElement="FED-5">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_1" bpmnElement="Step_1">
        <dc:Bounds x="370" y="170" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_2" bpmnElement="Step_2">
