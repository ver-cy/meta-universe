<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_FED-6" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="FED-6" name="Continuous synchronization operation" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Contracted schedule, change Events, or partner request" />
    <bpmn:task id="Step_1" name="1. Start cycle; precheck partner keys (GOV-8)" />
    <bpmn:exclusiveGateway id="Gw_1" name="Federation Active and contract unexpired?" />
    <bpmn:task id="Step_2" name="2. Compute outbound delta from mastered datasets" />
    <bpmn:task id="Step_3" name="3. Pass outbound batch through FED-4 and send" />
    <bpmn:task id="Step_4" name="4. Receive inbound into quarantine (FED-8)" />
    <bpmn:task id="Step_5" name="5. Apply promoted content to read-only mirrors" />
    <bpmn:task id="Step_6" name="6. Run MIR-7 boundary drift detection" />
    <bpmn:exclusiveGateway id="Gw_2" name="Drift or mapping errors found?" />
    <bpmn:task id="Step_7" name="Fix mechanical drift per contract rule (Agent T3)" />
    <bpmn:task id="Step_8" name="Open conflict object; hand to FED-9" />
    <bpmn:task id="Step_9" name="8. Close cycle: write sync report Event" />
    <bpmn:exclusiveGateway id="Gw_3" name="Failed cycles above threshold?" />
    <bpmn:endEvent id="End_1" name="Sync cycle complete" />
    <bpmn:endEvent id="End_2" name="Cycle stopped, alert raised" />
    <bpmn:endEvent id="End_3" name="Degraded; escalated to Steward" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_3" name="yes" sourceRef="Gw_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Gw_1" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_6" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_10" name="no" sourceRef="Gw_2" targetRef="Step_9" />
    <bpmn:sequenceFlow id="Flow_11" name="mechanical" sourceRef="Gw_2" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_12" name="semantic" sourceRef="Gw_2" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Step_7" targetRef="Step_9" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Step_8" targetRef="Step_9" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Step_9" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_16" name="no" sourceRef="Gw_3" targetRef="End_1" />
    <bpmn:sequenceFlow id="Flow_17" name="yes" sourceRef="Gw_3" targetRef="End_3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_FED_6">
