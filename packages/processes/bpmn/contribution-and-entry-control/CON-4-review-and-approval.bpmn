<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CON-4" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="CON-4" name="Review and approval" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Contribution passes CON-3 gates" />
    <bpmn:task id="Step_1" name="1. Classify impact and semantic change type (Agent T2)" />
    <bpmn:task id="Step_2" name="2. Run diff-based lane classifier (GOV-2 config)" />
    <bpmn:exclusiveGateway id="Gw_1" name="Auto-approval lane?" />
    <bpmn:task id="Step_3" name="Auto-approve and merge with audit trail (Agent T3)" />
    <bpmn:exclusiveGateway id="Gw_2" name="Touches security-critical dataset class?" />
    <bpmn:task id="Step_4" name="3. Enforce T1 acceptance, second human reviewer" />
    <bpmn:task id="Step_5" name="4. Assign reviewers per approval matrix (Agent T2)" />
    <bpmn:exclusiveGateway id="Gw_3" name="Contributor is the sole required approver?" />
    <bpmn:task id="Step_6" name="4. Add an independent reviewer (Steward)" />
    <bpmn:task id="Step_7" name="5. Assess meaning, placement, consequences (Steward)" />
    <bpmn:exclusiveGateway id="Gw_4" name="Approve, request changes, or reject?" />
    <bpmn:endEvent id="End_2" name="Returned to the Contributor" />
    <bpmn:endEvent id="End_3" name="Rejected with rationale" />
    <bpmn:task id="Step_8" name="7. Record decision Event, hand to CON-6 (Agent T3)" />
    <bpmn:endEvent id="End_1" name="Approved entry handed to CON-6" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gw_1" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_3" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_1" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_7" name="yes" sourceRef="Gw_2" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_9" name="no" sourceRef="Gw_2" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_5" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="Gw_3" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_6" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_13" name="no" sourceRef="Gw_3" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Step_7" targetRef="Gw_4" />
    <bpmn:sequenceFlow id="Flow_15" name="approve" sourceRef="Gw_4" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_16" name="request changes" sourceRef="Gw_4" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_17" name="reject" sourceRef="Gw_4" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Step_8" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CON-4">
    <bpmndi:BPMNPlane id="Plane_CON-4" bpmnElement="CON-4">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_1_di" bpmnElement="Step_1">
