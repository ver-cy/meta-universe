<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CON-2" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="CON-2" name="Provenance capture" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Contribution accepted by CON-1" />
    <bpmn:task id="Step_1" name="1. Determine asserting actor and contract (Agent T3)" />
    <bpmn:task id="Step_2" name="2. Record timestamp and entry channel (Agent T3)" />
    <bpmn:task id="Step_3" name="3. Classify origin: authored, harvested, generated (T3)" />
    <bpmn:exclusiveGateway id="Gw_1" name="Origin determinable?" />
    <bpmn:endEvent id="End_2" name="Entry held, escalated to Steward" />
    <bpmn:task id="Step_4" name="4. Record origin-specific provenance record (Agent T3)" />
    <bpmn:task id="Step_5" name="5. Capture rationale from the Contributor" />
    <bpmn:task id="Step_6" name="6. Emit assertedBy and derivedFrom edges (Agent T3)" />
    <bpmn:exclusiveGateway id="Gw_2" name="Provenance complete per the model schema?" />
    <bpmn:endEvent id="End_3" name="Returned to the Contributor" />
    <bpmn:task id="Step_7" name="7. Mark provenance-complete and release (Agent T3)" />
    <bpmn:endEvent id="End_1" name="Released to CON-3" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_5" name="no" sourceRef="Gw_1" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gw_1" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_6" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_10" name="no" sourceRef="Gw_2" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="Gw_2" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_7" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CON-2">
    <bpmndi:BPMNPlane id="Plane_CON-2" bpmnElement="CON-2">
