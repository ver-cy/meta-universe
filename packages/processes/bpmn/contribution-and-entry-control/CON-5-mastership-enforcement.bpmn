<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CON-5" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="CON-5" name="Mastership enforcement" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Write attempt on the model" />
    <bpmn:task id="Step_1" name="1. Resolve target dataset in sources.yaml (Agent T3)" />
    <bpmn:exclusiveGateway id="Gw_1" name="Register entry exists?" />
    <bpmn:exclusiveGateway id="Gw_2" name="External system involved or ambiguous?" />
    <bpmn:endEvent id="End_2" name="Write refused, register-gap task opened" />
    <bpmn:task id="Step_2" name="Author in place via CON-3 and CON-4, file MIR-1 task" />
    <bpmn:endEvent id="End_3" name="Model-mastered write proceeds" />
    <bpmn:exclusiveGateway id="Gw_3" name="Is the model the master?" />
    <bpmn:task id="Step_3" name="2. Edit in place through CON-3 and CON-4" />
    <bpmn:endEvent id="End_4" name="In-place edit merged in the model" />
    <bpmn:task id="Step_4" name="3. Refuse in-place edit, package correction (Agent T3)" />
    <bpmn:task id="Step_5" name="4. Deliver correction to the master system holder" />
    <bpmn:task id="Step_6" name="5. Record separated model-mastered annotation (Steward)" />
    <bpmn:task id="Step_7" name="6. Trigger re-harvest, record routing Event (Agent T3)" />
    <bpmn:endEvent id="End_1" name="Correction routed to the external master" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_3" name="no" sourceRef="Gw_1" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gw_2" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_5" name="no" sourceRef="Gw_2" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_2" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_7" name="yes" sourceRef="Gw_1" targetRef="Gw_3" />
    <bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gw_3" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_3" targetRef="End_4" />
    <bpmn:sequenceFlow id="Flow_10" name="no" sourceRef="Gw_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Step_6" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Step_7" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CON-5">
    <bpmndi:BPMNPlane id="Plane_CON-5" bpmnElement="CON-5">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_1_di" bpmnElement="Step_1">
