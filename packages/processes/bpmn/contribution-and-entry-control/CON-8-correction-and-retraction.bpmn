<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CON-8" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="CON-8" name="Correction and retraction" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Error report or CON-9 ruling received" />
    <bpmn:task id="Step_1" name="1. Register the defect report (Agent T3)" />
    <bpmn:exclusiveGateway id="Gw_1" name="Is the affected content model-mastered?" />
    <bpmn:task id="Step_2" name="2. Route correction to the master via CON-5" />
    <bpmn:endEvent id="End_2" name="Routed to external master via CON-5" />
    <bpmn:task id="Step_3" name="3. Run impact analysis on Provenance Graph (Agent T3)" />
    <bpmn:exclusiveGateway id="Gw_2" name="Correction or retraction?" />
    <bpmn:task id="Step_4" name="4. Author fix as a new version (CON-3, CON-4)" />
    <bpmn:task id="Step_5" name="4. Mark entry retracted, keep history (Steward T1)" />
    <bpmn:task id="Step_6" name="5. Record Event with primary reason code (Agent T3)" />
    <bpmn:task id="Step_7" name="6. Notify Consumers per the CON-13 register (Agent T3)" />
    <bpmn:task id="Step_8" name="7. Close the report with the resolution" />
    <bpmn:endEvent id="End_1" name="Report closed" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_3" name="no, a mirror" sourceRef="Gw_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_2" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_1" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_7" name="correction" sourceRef="Gw_2" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_8" name="retraction" sourceRef="Gw_2" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_4" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Step_6" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_7" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Step_8" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CON-8">
    <bpmndi:BPMNPlane id="Plane_CON-8" bpmnElement="CON-8">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
