<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CON-6" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="CON-6" name="Versioning and change history" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="CON-4 approves a contribution" />
    <bpmn:task id="Step_1" name="1. Apply change to the master location (Agent T3)" />
    <bpmn:task id="Step_2" name="2. Record transition Event with reason code (Agent T3)" />
    <bpmn:task id="Step_3" name="3. Advance version identifiers per policy (Agent T3)" />
    <bpmn:task id="Step_4" name="4. Update the change log with links (Agent T3)" />
    <bpmn:exclusiveGateway id="Gw_1" name="Files added, moved or deleted?" />
    <bpmn:task id="Step_5" name="5. Re-run coverage walker, commit report (Agent T3)" />
    <bpmn:exclusiveGateway id="Gw_2" name="Dataset, pipeline or mastership changed?" />
    <bpmn:task id="Step_6" name="6. Execute register change via MIR-1 (Agent T3)" />
    <bpmn:task id="Step_7" name="7. Publish state, trigger MIR-7 drift check (Agent T3)" />
    <bpmn:endEvent id="End_1" name="Change published with full history" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_4" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gw_1" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_5" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_8" name="no" sourceRef="Gw_1" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_9" name="yes" sourceRef="Gw_2" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_6" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_11" name="no" sourceRef="Gw_2" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_7" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CON-6">
    <bpmndi:BPMNPlane id="Plane_CON-6" bpmnElement="CON-6">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_1_di" bpmnElement="Step_1">
        <dc:Bounds x="370" y="148" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_2_di" bpmnElement="Step_2">
        <dc:Bounds x="580" y="148" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_3_di" bpmnElement="Step_3">
        <dc:Bounds x="790" y="148" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_4_di" bpmnElement="Step_4">
