<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CON-3" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="CON-3" name="Validation gates" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Contribution released by CON-2" />
    <bpmn:task id="Step_1" name="1. Run syntax validation V0 (Agent T3)" />
    <bpmn:task id="Step_2" name="2. Run structural validation V1 (Agent T3)" />
    <bpmn:task id="Step_3" name="3. Run schema validation for the kind (Agent T3)" />
    <bpmn:task id="Step_4" name="4. Run naming and style checks (Agent T3)" />
    <bpmn:task id="Step_5" name="5. Run link integrity V2 on the link index (Agent T3)" />
    <bpmn:task id="Step_6" name="6. Run policy consistency check (Agent T3)" />
    <bpmn:exclusiveGateway id="Gw_1" name="All gates pass?" />
    <bpmn:endEvent id="End_2" name="Validation failed, report returned" />
    <bpmn:endEvent id="End_1" name="Validation passed, routed to CON-4" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_6" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_8" name="no" sourceRef="Gw_1" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_9" name="yes" sourceRef="Gw_1" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CON-3">
    <bpmndi:BPMNPlane id="Plane_CON-3" bpmnElement="CON-3">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_1_di" bpmnElement="Step_1">
        <dc:Bounds x="370" y="148" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_2_di" bpmnElement="Step_2">
