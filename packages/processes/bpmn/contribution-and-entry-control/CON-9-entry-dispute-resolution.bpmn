<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CON-9" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="CON-9" name="Entry dispute resolution" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="A role disputes an entry" />
    <bpmn:task id="Step_1" name="1. Register the dispute (Event: dispute opened)" />
    <bpmn:task id="Step_2" name="2. Mark the entry Disputed, keep visible (Agent T3)" />
    <bpmn:task id="Step_3" name="3. Compile the evidence file (Agent T3)" />
    <bpmn:exclusiveGateway id="Gw_1" name="Mastership or partition contested?" />
    <bpmn:task id="Step_4" name="4. Escalate mastership proposal to MIR-1" />
    <bpmn:endEvent id="End_2" name="Escalated to MIR-1" />
    <bpmn:task id="Step_5" name="5. Draft assessment; Steward rules (Agent T2, human)" />
    <bpmn:task id="Step_6" name="6. Apply ruling via CON-4 or CON-8, clear mark" />
    <bpmn:task id="Step_7" name="7. Record the ruling Event with rationale" />
    <bpmn:exclusiveGateway id="Gw_2" name="Does the disputant appeal?" />
    <bpmn:task id="Step_8" name="Owner hears appeal, records GOV-1 Event (Owner T1)" />
    <bpmn:endEvent id="End_3" name="Owner decision final" />
    <bpmn:endEvent id="End_1" name="Ruling final" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_1" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_4" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gw_1" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_6" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_7" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="Gw_2" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_8" targetRef="End_3" />
    <bpmn:sequenceFlow id="Flow_13" name="no" sourceRef="Gw_2" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CON-9">
    <bpmndi:BPMNPlane id="Plane_CON-9" bpmnElement="CON-9">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_1_di" bpmnElement="Step_1">
