<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CON-13" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="CON-13" name="Consumer and subscription register" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Grant received or recertification due" />
    <bpmn:task id="Step_1" name="1. Register Consumer with channel, SLA, grants" />
    <bpmn:task id="Step_2" name="2. Record consumed datasets and dependencies" />
    <bpmn:task id="Step_3" name="3. Synchronize with the grant registers (Agent T3)" />
    <bpmn:task id="Step_4" name="4. Serve addressee lists for notification runs" />
    <bpmn:task id="Step_5" name="5. Recertify entries, end dead ones (Steward)" />
    <bpmn:task id="Step_6" name="6. Report dependency stats to QSC-11, GOV-5" />
    <bpmn:endEvent id="End_1" name="Register current and served" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_6" targetRef="End_1" />
  </bpmn:process>
