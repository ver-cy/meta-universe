<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CON-12" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="CON-12" name="Standard and schema migration" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="GOV-1 adopts a new standard version" />
    <bpmn:task id="Step_1" name="1. Author plan CR, approve at T1 (Steward, Owner)" />
    <bpmn:task id="Step_2" name="2. Preserve pre-migration state per MIR-9" />
    <bpmn:task id="Step_3" name="3. Execute transformation in a branch (Agent T2)" />
    <bpmn:task id="Step_4" name="4. Dual-run QSC-4 on old and new levels" />
    <bpmn:task id="Step_5" name="5. Notify peers, maintain FED-7 mappings" />
    <bpmn:exclusiveGateway id="Gw_1" name="Dual validation green, window declared?" />
    <bpmn:task id="Step_6" name="6. Fix mapping rules and repeat (Agent T2)" />
    <bpmn:endEvent id="End_2" name="Migration aborted, branch retained" />
    <bpmn:task id="Step_7" name="7. Cut over as one revertible change (Agent T2)" />
    <bpmn:task id="Step_8" name="8. Update QSC-10 statement; Auditor samples" />
    <bpmn:endEvent id="End_1" name="Migration complete and conformant" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_5" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_7" name="yes" sourceRef="Gw_1" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_8" name="rework" sourceRef="Gw_1" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_6" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_10" name="abort" sourceRef="Gw_1" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Step_7" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_8" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CON-12">
    <bpmndi:BPMNPlane id="Plane_CON-12" bpmnElement="CON-12">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_1_di" bpmnElement="Step_1">
