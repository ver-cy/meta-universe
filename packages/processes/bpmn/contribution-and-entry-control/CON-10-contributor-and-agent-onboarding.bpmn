<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CON-10" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="CON-10" name="Contributor and Agent onboarding" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Rights request or CTX-9 event arrives" />
    <bpmn:task id="Step_1" name="1. Establish identity and accountable operator" />
    <bpmn:exclusiveGateway id="Gw_1" name="Human or agent?" />
    <bpmn:task id="Step_2" name="2. Deliver briefing, obtain acknowledgment (Agent T2)" />
    <bpmn:task id="Step_3" name="2. Verify AI-native fitness, get CTX-9 contract (T2)" />
    <bpmn:task id="Step_4" name="3. Define scope with the Steward, mastered data only" />
    <bpmn:task id="Step_5" name="4. Record grant Event, provision access (grant T1)" />
    <bpmn:task id="Step_6" name="5. Propagate revocations within TTL, probe (Agent T2)" />
    <bpmn:task id="Step_7" name="6. Run periodic rights recertification (Steward)" />
    <bpmn:exclusiveGateway id="Gw_2" name="Breach of obligations?" />
    <bpmn:task id="Step_8" name="7. Revoke rights, notify CTX-9, re-review (T1)" />
    <bpmn:endEvent id="End_2" name="Rights revoked, entries re-reviewed" />
    <bpmn:endEvent id="End_1" name="Rights current and registered" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Gw_1" />
    <bpmn:sequenceFlow id="Flow_3" name="human" sourceRef="Gw_1" targetRef="Step_2" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_2" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_5" name="agent" sourceRef="Gw_1" targetRef="Step_3" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3" targetRef="Step_4" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_4" targetRef="Step_5" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Step_6" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_6" targetRef="Step_7" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_7" targetRef="Gw_2" />
    <bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="Gw_2" targetRef="Step_8" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_8" targetRef="End_2" />
    <bpmn:sequenceFlow id="Flow_13" name="no" sourceRef="Gw_2" targetRef="End_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CON-10">
    <bpmndi:BPMNPlane id="Plane_CON-10" bpmnElement="CON-10">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_1_di" bpmnElement="Step_1">
        <dc:Bounds x="370" y="148" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_1_di" bpmnElement="Gw_1">
        <dc:Bounds x="580" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Step_2_di" bpmnElement="Step_2">
        <dc:Bounds x="685" y="330" width="160" height="80" />
      </bpmndi:BPMNShape>
