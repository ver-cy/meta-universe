<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CTX-8" targetNamespace="https://ver.cy/processes"><bpmn:process id="CTX-8" name="Actor handoff" isExecutable="false"><bpmn:startEvent id="Start_1" name="Session end, reassignment or revocation"/><bpmn:task id="Step_1" name="1. Bring model to declared state, walk green"/><bpmn:task id="Step_2" name="2. Write Handoff Note as model content"/><bpmn:exclusiveGateway id="Gw_1" name="Incoming actor identified and authorized?"/><bpmn:task id="Step_4" name="4. Transfer partition, record handoff event"/><bpmn:task id="Step_5" name="5. Bootstrap (CTX-10) and read the note (Agent T3)"/><bpmn:exclusiveGateway id="Gw_2" name="Does the incoming actor accept the state?"/><bpmn:task id="Step_6" name="6. Resume the FCD loop (CTX-5)"/><bpmn:endEvent id="End_1" name="Handoff complete, work resumed"/><bpmn:task id="Step_3" name="3. Park work, address note to Steward"/><bpmn:endEvent id="End_2" name="Work parked for the Steward"/><bpmn:task id="Step_7" name="Report discrepancies before resuming"/><bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/><bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2"/><bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Gw_1"/><bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gw_1" targetRef="Step_4"/><bpmn:sequenceFlow id="Flow_5" name="no" sourceRef="Gw_1" targetRef="Step_3"/><bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3" targetRef="End_2"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Step_4" targetRef="Step_5"/><bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Gw_2"/><bpmn:sequenceFlow id="Flow_9" name="yes" sourceRef="Gw_2" targetRef="Step_6"/><bpmn:sequenceFlow id="Flow_10" name="no" sourceRef="Gw_2" targetRef="Step_7"/><