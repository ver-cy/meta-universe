<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CTX-5" targetNamespace="https://ver.cy/processes"><bpmn:process id="CTX-5" name="Full context task execution (the FCD loop)" isExecutable="false"><bpmn:startEvent id="Start_1" name="Task assignment against model or reality"/><bpmn:task id="Step_1" name="1. Receive the task (Contributor or Agent)"/><bpmn:exclusiveGateway id="Gw_1" name="Right place, permission and contract live?"/><bpmn:task id="Step_2" name="2. Gather context via CTX-1 and CTX-2 (Agent T3)"/><bpmn:exclusiveGateway id="Gw_2" name="Is the context sufficient?"/><bpmn:task id="Step_4" name="4. Plan change, look up dataset masters"/><bpmn:exclusiveGateway id="Gw_3" name="Does a write target a non-master copy?"/><bpmn:task id="Step_6" name="6. Execute task; external acts via ACT-6"/><bpmn:task id="Step_7" name="7. Write back through the CON chain (T2)"/><bpmn:task id="Step_8" name="8. Re-run walker and MIR-7 drift checks"/><bpmn:task id="Step_9" name="9. Record execution event, feed CTX-11"/><bpmn:endEvent id="End_1" name="Task done, model updated, walk green"/><bpmn:endEvent id="End_2" name="Refused or escalated to Steward"/><bpmn:task id="Step_3" name="3. Extend extraction or ask Steward"/><bpmn:task id="Step_5" name="5. Redirect write to master or propose"/><bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/><bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Gw_1"/><bpmn:sequenceFlow id="Flow_3" name="yes" sourceRef="Gw_1" targetRef="Step_2"/><bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Gw_1" targetRef="End_2"/><bpmn:sequenceFlow id="Flow_5" sourceRef="Step_2" targetRef="Gw_2"/><bpmn:sequenceFlow id="Flow_6" name="yes" sourceRef="Gw_2" targetRef="Step_4"/><bpmn:sequenceFlow id="Flow_7" name="no" sourceRef="Gw_2" targetRef="Step_3"/><bpmn:sequenceFlow id="Flow_8" sourceRef="Step_3" targetRef="Step_2"/><bpmn:sequenceFlow id="Flow_9" sourceRef="Step_4" targetRef="Gw_3"/><bpmn:sequenceFlow id="Flow_10" name="no" sourceRef="Gw_3" targetRef="Step_6"/><bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="Gw_3" targetRef="Step_5"/><bpmn:sequenceFlow id="Flow_12" sourceRef="Step_5" targetRef="Step_6"/><bpmn:sequenceFlow id="Flow_13" sourceRef="Step_6" targetRef="Step_7"/><bpmn:sequenceFlow id="Flow_14" sourceRef="Step_7" targetRef="Step_8"/><bpmn:sequenceFlow id="Flow_15" sourceRef="Step_8" targetRef="Step_9"/><bpmn:sequenceFlow id="Flow_16" sourceRef="Step_9" targetRef="End_1"/></bpmn:process><bpmndi:BPMNDiagram id="Diag_CTX-5"><bpmndi:BPMNPlane id="Plane_CTX-5" bpmnElement="CTX-5"><bpmndi:BPMNShape id="d_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="192" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_1" bpmnElement="Step_1"><dc:Bounds x="370" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Gw_1" bpmnElement="Gw_1"><dc:Bounds x="580" y="185" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_2" bpmnElement="Step_2"><dc:Bounds x="790" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Gw_2" bpmnElement="Gw_2"><dc:Bounds x="1000" y="185" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_4" bpmnElement="Step_4"><dc:Bounds x="1210" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Gw_3" bpmnElement="Gw_3"><dc:Bounds x="1420" y="185" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_6" bpmnElement="Step_6"><dc:Bounds x="1630" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_7" bpmnElement="Step_7"><dc:Bounds x="1840" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_8" bpmnElement="Step_8"><dc:Bounds x="2050" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_9" bpmnElement="Step_9"><dc:Bounds x="2260" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_End_1" bpmnElement="End_1"><dc:Bounds x="2470" y="192" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_End_2" bpmnElement="End_2"><dc:Bounds x="685" y="352" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_3" bpmnElement="Step_3"><dc:Bounds x="1105" y="330" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_5" bpmnElement="Step_5"><dc:Bounds x="1525" y="330" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="d_Flow_1" bpmnElement="Flow_1"><di:waypoint x="196" y="210"/><di:waypoint x="370" y="188"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_2" bpmnElement="Flow_2"><di:waypoint x="530" y="188"/><di:waypoint x="580" y="210"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_3" bpmnElement="Flow_3"><di:waypoint x="630" y="210"/><di:waypoint x="790" y="188"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_4" bpmnElement="Flow_4"><di:waypoint x="630" y="210"/><di:waypoint x="685" y="370"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_5" bpmnElement="Flow_5"><di:waypoint x="950" y="188"/><di:waypoint x="1000" y="210"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_6" bpmnElement="Flow_6"><di:waypoint x="1050" y="210"/><di:waypoint x="1210" y="188"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_7" bpmnElement="Flow_7"><di:waypoint x="1050" y="210"/><di:waypoint x="1105" y="370"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_8" bpmnElement="Flow_8"><di:waypoint x="1265" y="370"/><di:waypoint x="790" y="188"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_9" bpmnElement="Flow_9"><di:waypoint x="1370" y="188"/><di:waypoint x="1420" y="210"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_10" bpmnElement="Flow_10"><di:waypoint x="1470" y="210"/><di:waypoint x="1630" y="188"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_11" bpmnElemen