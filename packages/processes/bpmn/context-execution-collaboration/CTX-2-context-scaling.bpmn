<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CTX-2" targetNamespace="https://ver.cy/processes"><bpmn:process id="CTX-2" name="Context scaling" isExecutable="false"><bpmn:startEvent id="Start_1" name="Window overflow or depth request"/><bpmn:task id="Step_1" name="1. Read depth profile declaration (Agent T3)"/><bpmn:task id="Step_2" name="2. Generate views at requested depth (Agent T3)"/><bpmn:task id="Step_3" name="3. Verify identity, taint, quarantine kept (Agent T3)"/><bpmn:exclusiveGateway id="Gw_1" name="Does the scaled set fit the target window?"/><bpmn:task id="Step_5" name="5. Stamp views as generated (Agent T3)"/><bpmn:task id="Step_6" name="6. Record generation event (Agent T3)"/><bpmn:endEvent id="End_1" name="Scaled views delivered"/><bpmn:task id="Step_4" name="4. Step down depth, record gaps (Agent T3)"/><bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/><bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2"/><bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3"/><bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Gw_1"/><bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_1" targetRef="Step_5"/><bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_1" targetRef="Step_4"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Step_4" targetRef="Step_5"/><bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Step_6"/><bpmn:sequenceFlow id="Flow_9" sourceRef="Step_6" targetRef="End_1"/></bpmn:process><bpmndi:BPMNDiagram id="Diag_CTX-2"><bpmndi:BPMNPlane id="Plane_CTX-2" bpmnElement="CTX-2"><bpmndi:BPMNShape id="d_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="192" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_1" bpmnElement="Step_1"><dc:Bound