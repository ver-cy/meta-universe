<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CTX-3" targetNamespace="https://ver.cy/processes"><bpmn:process id="CTX-3" name="Decomposition" isExecutable="false"><bpmn:startEvent id="Start_1" name="Task or model too large; partition request"/><bpmn:task id="Step_1" name="1. Build dependency graph (Agent T2)"/><bpmn:task id="Step_2" name="2. Propose cut lines (Agent T2)"/><bpmn:exclusiveGateway id="Gw_1" name="Does a cut split one mastered dataset?"/><bpmn:task id="Step_4" name="4. Steward approves the cut (Steward T1)"/><bpmn:task id="Step_5" name="5. Execute split, cross-part references (Agent T2)"/><bpmn:task id="Step_6" name="6. Re-run coverage walker on every part"/><bpmn:task id="Step_7" name="7. Record decomposition event"/><bpmn:endEvent id="End_1" name="Parts ready, all walks green"/><bpmn:task id="Step_3" name="3. Redraw cut or split dataset via MIR-1"/><bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/><bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2"/><bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Gw_1"/><bpmn:sequenceFlow id="Flow_4" name="no" sourceRef="Gw_1" targetRef="Step_4"/><bpmn:sequenceFlow id="Flow_5" name="yes" sourceRef="Gw_1" targetRef="Step_3"/><bpmn:sequenceFlow id="Flow_6" sourceRef="Step_3" targetRef="Step_2"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Step_4" targetRef="Step_5"/><bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Step_6"/><bpmn:sequenceFlow id="Flow_9" sourceRef="Step_6" targetRef="Step_7"/><bpmn:sequenceFlow id="Flow_10" sourceRef="Step_7" targetRef="End_1"/></bpmn:process><bpmndi:BPMNDiagram id="Diag_CTX-3"><bpmndi:BPMNPlane id="Plane_CTX-3" bpmnElement="CTX-3"><bpmndi:BPMNShape id="d_Start_1" bpmnElement="Start_1"><dc:Bounds x="1