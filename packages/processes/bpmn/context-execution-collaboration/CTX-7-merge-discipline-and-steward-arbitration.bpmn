<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_CTX-7" targetNamespace="https://ver.cy/processes"><bpmn:process id="CTX-7" name="Merge discipline and Steward arbitration" isExecutable="false"><bpmn:startEvent id="Start_1" name="Partition work complete or conflict found"/><bpmn:task id="Step_1" name="1. Queue contributions dependency-first (Agent T2)"/><bpmn:task id="Step_2" name="2. Mechanical merge, validate per batch (Agent T2)"/><bpmn:exclusiveGateway id="Gw_1" name="Overlap or contradiction detected?"/><bpmn:task id="Step_4" name="4. Classify the conflict (Agent T2)"/><bpmn:task id="Step_5" name="5. Apply declared conflict rules (Agent T2)"/><bpmn:exclusiveGateway id="Gw_2" name="Does a declared rule decide the conflict?"/><bpmn:task id="Step_7" name="7. Steward arbitration, record ruling (Steward T1)"/><bpmn:task id="Step_8" name="8. Hand integrated state to CON-4"/><bpmn:endEvent id="End_1" name="Integrated state in CON-4, walk green"/><bpmn:endEvent id="End_2" name="Closed with merge record"/><bpmn:task id="Step_6" name="6. Apply the rule and record"/><bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/><bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2"/><bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Gw_1"/><bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gw_1" targetRef="Step_4"/><bpmn:sequenceFlow id="Flow_5" name="no" sourceRef="Gw_1" targetRef="End_2"/><bpmn:sequenceFlow id="Flow_6" sourceRef="Step_4" targetRef="Step_5"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Step_5" targetRef="Gw_2"/><bpmn:sequenceFlow id="Flow_8" name="no" sourceRef="Gw_2" targetRef="Step_7"/><bpmn:sequenceFlow id="Flow_9" name="yes" sourceRef="Gw_2" targetRef="Step_6"/><bpmn:sequenceFlow id="Flow_10" sourceRef="Step_6" targetRef="Step_8"/><bpmn:sequenceFlow id="Flow_11" sourceRef="Step_7" targetRef="Step_8"/><bpmn:sequenceFlow id="Flow_12" sourceRef="Step_8" targetRef="End_1"/></bpmn:process><bpmndi:BPMNDiagram id="Diag_CTX-7"><bpmndi:BPMNPlane id="Plane_CTX-7" bpmnElement="CTX-7"><bpmndi:BPMNShape id="d_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="192" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_1" bpmnElement="Step_1"><dc:Bounds x="370" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_2" bpmnElement="Step_2"><dc:Bounds x="580" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Gw_1" bpmnElement="Gw_1"><dc:Bounds x="790" y="185" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_4" bpmnElement="Step_4"><dc:Bounds x="1000" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_5" bpmnElement="Step_5"><dc:Bounds x="1210" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Gw_2" bpmnElement="Gw_2"><dc:Bounds x="1420" y="185" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_7" bpmnElement="Step_7"><dc:Bounds x="1630" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_8" bpmnElement="Step_8"><dc:Bounds x="1840" y="148" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_End_1" bpmnElement="End_1"><dc:Bounds x="2050" y="192" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_End_2" bpmnElement="End_2"><dc:Bounds x="895" y="352" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="d_Step_6" bpmnElement="Step_6"><dc:Bounds x="1525" y="330" width="160" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="d_Flow_1" bpmnElement="Flow_1"><di:waypoint x="196" y="210"/><di:waypoint x="370" y="188"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="d_Flow_2" bpmnElement="Flow_2"><di:waypoint x="530" y="188"/><di:waypoint x="580" y="1