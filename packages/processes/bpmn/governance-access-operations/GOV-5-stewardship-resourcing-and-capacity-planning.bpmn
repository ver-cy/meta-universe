<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_GOV-5" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="GOV-5" name="Stewardship resourcing and capacity planning" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Planning cadence due or threshold trip"/>
    <bpmn:task id="Step_1" name="1. Collect period telemetry (Agent T3)"/>
    <bpmn:task id="Step_2" name="2. Project storage, compute, hours (Agent T3)"/>
    <bpmn:exclusiveGateway id="Gw_1" name="Obligation exceeds projected capacity?"/>
    <bpmn:task id="Step_3" name="3a. List underfunded cadences explicitly"/>
    <bpmn:task id="Step_4" name="4. Draft plan with trade-offs (Agent T2)"/>
    <bpmn:task id="Step_5" name="5. Accept plan at T1 (Owner); record Events"/>
    <bpmn:task id="Step_6" name="6. Publish plan and telemetry to QSC-11"/>
    <bpmn:task id="Step_7" name="7. Watch thresholds between cycles (Agent T3)"/>
    <bpmn:endEvent id="End_1" name="Capacity plan in force"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Gw_1"/>
    <bpmn:sequenceFlow id="Flow_4" name="yes" sourceRef="Gw_1" targetRef="Step_3"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_3" targetRef="Step_4"/>
    <bpmn:sequenceFlow id="Flow_6" name="no" sourceRef="Gw_1" targetRef="Step_4"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_4" targetRef="Step_5"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Step_5" targetRef="Step_6"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Step_6" targetRef="Step_7"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_7" targetRef="End_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_GOV-5">
    <bpmndi:BPMNPlane id="Plane_GOV-5" bpmnElement="GOV-5">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1"><dc:Bounds x="160" y="192" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_1" bpmnElement="Step_1"><dc:Bounds x="370" y="148" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_2" bpmnElement="Step_2"><dc:Bounds x="580" y="148" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_1" bpmnElement="Gw_1"><dc:Bounds x="790" y="185" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_3" bpmnElement="Step_3"><dc:Bounds x="895" y="330" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_4" bpmnElement="Step_4"><dc:Bounds x="1000" y="148" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_5" bpmnElement="Step_5"><dc:Bounds x="1210" y="148" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_6" bpmnElement="Step_6"><dc:Bounds x="1420" y="148" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Step_7" bpmnElement="Step_7"><dc:Bounds x="1630" y="148" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_1" bpmnElement="End_1"><dc:Bounds x="1840" y="192" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1"><di:waypoint x="196" y="210"/><di:waypoint x="370" y="188"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2"><di:waypoint x="530" y="188"/><di:waypoint x="580" y="188"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3"><di:waypoint x="740" y="188"/><di:waypoint x="790" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4"><di:waypoint x="840" y="210"/><di:waypoint x="895" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5"><di:waypoint x="1055" y="370"/><di:waypoint x="1000" y="188"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6"><di:waypoint x="840" y="210"/><di:waypoint x="1000" y="188"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7"><di:waypoint x="1160" y="188"/><di:waypoint x="1210" y="188"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8"><di:waypoint x="1370" y="188"/><di:waypoint x="1420" y="188"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9"><di:waypoint x="1580" y="188"/><di:waypoint x="1630" y="188"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10"><di:waypoint x="1790" y="188"/><di:waypoint x="1840" y="210"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
