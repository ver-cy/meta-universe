<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_GOV-4" targetNamespace="https://ver.cy/processes">
  <bpmn:process id="GOV-4" name="Model and Dimension genesis" isExecutable="false">
    <bpmn:startEvent id="Start_1" name="Founding decision by Owner (GOV-1)"/>
    <bpmn:task id="Step_1" name="1. Record founding decision in GOV-1"/>
    <bpmn:task id="Step_2" name="2. Appoint roles; succession skeleton (GOV-3)"/>
    <bpmn:task id="Step_3" name="3. Scaffold repository from template (Agent T2)"/>
    <bpmn:task id="Step_4" name="4. Instantiate policy set from defaults (GOV-2)"/>
    <bpmn:task id="Step_5" name="5. Initialize registers, cadences, standing jobs"/>
    <bpmn:task id="Step_6" name="6. Seed content via lawful paths only"/>
    <bpmn:exclusiveGateway id="Gw_1" name="First QSC-4 validation green?"/>
    <bpmn:task id="Step_7" name="7a. Remediate and re-run validation"/>
    <bpmn:task id="Step_8" name="8. Register model in Universe registry"/>
    <bpmn:task id="Step_9" name="9. Emit activation Event; expire genesis grants"/>
    <bpmn:endEvent id="End_1" name="Model Active"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Step_1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Step_1" targetRef="Step_2"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Step_2" targetRef="Step_3"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Step_3" targetRef="Step_4"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Step_4" targetRef="Step_5"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Step_5" targetRef="Step_6"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Step_6" targetRef="Gw_1"/>
    <bpmn:sequenceFlow id="Flow_8" name="yes" sourceRef="Gw_1" targetRef="Step_8"/>
    <bpmn:sequenceFlow id="Flow_9" name="no" sourceRef="Gw_1" targetRef="Step_7"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Step_7" targetRef="Gw_1"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Step_8" targetRef="Step_9"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Step_9" targetRef="End_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_GOV-4">
